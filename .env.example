# SentinelSOC Environment Configuration

# ==============================================================================
# SECTION 1: GLOBAL SETTINGS
# ==============================================================================
# Environment: 'development', 'testing', or 'production'
ENVIRONMENT=development

# The base URL of the frontend (e.g. http://localhost:3000, https://soc.example.com)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ==============================================================================
# SECTION 2: BACKEND CONFIGURATION
# ==============================================================================
# Application binding (Production backend only)
API_HOST=0.0.0.0
API_PORT=8000

# Secret Key used for JWT Authentication. MUST BE CHANGED IN PRODUCTION!
# Generate a strong key using: openssl rand -hex 32
SECRET_KEY=replace-with-a-long-random-production-secret-do-not-use-this

# CORS Origins (JSON list format)
# In production, set this to ONLY the exact URL of the frontend e.g. ["https://soc.example.com"]
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Token expiry
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Rate Limiting & Security (in-memory)
AUTH_RATE_LIMIT_ENABLED=True
AUTH_MAX_ATTEMPTS=10
AUTH_LOCKOUT_SECONDS=300
MAX_EVENT_PAYLOAD_BYTES=65536

# ==============================================================================
# SECTION 3: DATABASE CONFIGURATION
# ==============================================================================
# PostgreSQL Connection URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=postgresql://sentinelsoc:socpassword@postgres:5432/sentinelsoc

# Internal PostgreSQL credentials (used by docker-compose to initialize the DB)
POSTGRES_USER=sentinelsoc
POSTGRES_PASSWORD=socpassword
POSTGRES_DB=sentinelsoc

# ==============================================================================
# SECTION 4: MACHINE LEARNING (ML) CONFIGURATION
# ==============================================================================
ML_ENABLED=True
ML_WINDOW_SECONDS=300
ML_TRAINING_DAYS=7
ML_MIN_TRAINING_SAMPLES=30
ML_ANOMALY_THRESHOLD=75
# Model storage path (persisted via Docker volumes)
ML_MODEL_DIRECTORY=/app/ml_models
ML_RANDOM_STATE=42
ML_N_ESTIMATORS=100

# ==============================================================================
# SECTION 5: THREAT INTELLIGENCE (TI) CONFIGURATION
# ==============================================================================
TI_ENABLED=False
# 'mock', 'virustotal', 'alienvault'
TI_PROVIDER=mock
# Keep this secure. DO NOT place in NEXT_PUBLIC_ variables.
TI_API_KEY=
TI_TIMEOUT_SECONDS=5
TI_CACHE_TTL_SECONDS=3600
TI_MAX_LOOKUPS_PER_EVENT=5

# ==============================================================================
# SECTION 6: AUTOMATED RESPONSE CONFIGURATION
# ==============================================================================
# Enable/Disable automatic response actions (firewall blocks, host isolation, etc)
# KEEP DISABLED BY DEFAULT for safety.
AUTO_RESPONSE_ENABLED=False
RESPONSE_ACTION_TIMEOUT_SECONDS=15
RESPONSE_ACTION_MAX_RETRIES=3

# ==============================================================================
# SECTION 7: NOTIFICATIONS & SMTP CONFIGURATION
# ==============================================================================
EMAIL_ENABLED=False
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
# Keep this secure. DO NOT place in NEXT_PUBLIC_ variables.
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=noreply@sentinelsoc.local
SMTP_USE_TLS=True

NOTIFICATION_DEDUP_WINDOW_SECONDS=900
NOTIFICATION_EMAIL_MAX_PER_HOUR=20

# ==============================================================================
# SECTION 8: REPORTS CONFIGURATION
# ==============================================================================
REPORT_MAX_RANGE_DAYS=90
REPORT_CACHE_TTL_SECONDS=300
